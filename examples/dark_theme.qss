QMainWindow {
    background-color: #252526;
}
QLabel, QLineEdit, QComboBox, QGroupBox, QPushButton {
    color: #dddddd;
    font-size: 14px;
}
QLineEdit, QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px;
}
QGroupBox {
    border: 1px solid #444;
    border-radius: 6px;
    margin-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: #cccccc;
}
QPushButton {
    background-color: #0e639c;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: white;
}
QPushButton:hover {
    background-color: #1177bb;
}
QPushButton:disabled {
    background-color: #3a3a3a;
    color: #777;
}
QToolButton:checked {
    background-color: rgba(220, 53, 69, 220);
}
QToolButton#start_button {
    background-color: rgba(40, 167, 69, 220);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 4px;
}
QToolButton#start_button:checked {
    background-color: rgba(220, 53, 69, 220); /* red when pressed */
}
QToolButton#floating_button {
    background-color: rgba(14, 99, 156, 150);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 4px;
}
QToolButton#floating_button:hover {
    background-color: rgba(17, 119, 187, 220);
}
    QToolButton#check_button {
    background-color: rgba(14, 99, 156, 0);
    color: white;
    border: 2px solid rgb(120, 120, 150);
    border-radius: 40px; /* half of width/height for a perfect circle */
    padding: 4px;
}
QToolButton#check_button:checked {
    border: none;
    background-color: rgba(14, 99, 156, 220);
}
QToolButton#check_button:hover {
    border: 2px solid rgb(220, 220, 250);
    background-color: rgba(24, 109, 166, 220);
}
QToolButton:hover {
    background-color: rgba(24, 109, 166, 220);
    }
QLabel#MtfLabel {
    font-size: 62px;
    font-weight: bold;
    color: #00ffff;
    font-family: "Courier New", monospace;
    padding: 4px;
}
QLabel#Mtf_units_Label {
    font-size: 14px;
    font-weight: bold;
    color: #aaaaaa;
    font-family: "Courier New", monospace;
    padding-bottom: 4px;    /* pushes text visually toward bottom */
    qproperty-alignment: AlignBottom; /* hint for Qt internal alignment */
}
QPushButton#StartStopButton {
    background-color: #28a745;  /* green */
    color: white;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#StartStopButton:hover {
    background-color: #218838;
}
QGroupBox#PlotGroup {
        font-weight: bold;
        font-size: 18px;
        color: white;
        border: none;
        padding-top: 20px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 20px;
        background-color: #171717;
    }
    QGroupBox#PlotGroup::title {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        padding: 4px 8px;
        color: white;
    }      
QGroupBox#plot_group {
    font-weight: bold;
    font-size: 18px;
    color: white;
    border: 1px solid #444;
    border-radius: 6px;
    margin-top: 6px;
}
QGroupBox#plot_group::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: white;
}
QToolButton#saturation_label {
    background-color: rgba(255, 50, 50, 180);  /* red circle */
    color: lightyellow;
    border: none;
    border-radius: 40px;  /* half of width/height -> circle */
    padding: 2px;
}
QToolButton#saturation_label:disabled {
    color: lightyellow;
    background-color: rgba(255, 50, 50, 180);
    border: none;
    font-weight: bold;
    }
QHeaderView::section {
    background-color: #222;
    color: white;
    font-size: 16px;
}
QTableWidget {
    color: gray;
    font-size: 18px;
}